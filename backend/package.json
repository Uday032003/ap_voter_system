{
  "name": "ap-voter-backend",
  "version": "1.0.0",
  "description": "Backend API for Andhra Pradesh Voter Directory & Constituency Management System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "build": "node -e \"console.log('Backend ready for deployment')\"",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seedData.js",
    "migrate": "node src/scripts/runMigrations.js",
    "test": "node --test src/tests/**/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
